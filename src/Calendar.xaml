<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="458" Height="542"
      TextElement.FontFamily="Segoe UI, Yu Gothic UI" TextElement.Foreground="#E3F4F4"
      TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <Grid.Resources>
    <Style TargetType="ToolTip">
      <Setter Property="MaxWidth" Value="380"/>
      <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></Setter.Value></Setter>
      <Setter Property="Background" Value="#102835"/><Setter Property="Foreground" Value="#DBEDF0"/>
      <Setter Property="BorderBrush" Value="#528793"/><Setter Property="Padding" Value="9,6"/>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Height" Value="24"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Grid Background="Transparent">
          <Track Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" Orientation="Horizontal">
            <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="2" Background="#7BE5DA" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb Width="10" Height="22"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Ellipse Width="8" Height="8" Fill="#FFE18B" Stroke="#132F3B" StrokeThickness="1" VerticalAlignment="Center"/></Grid></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="2" Background="#365B66" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#DBEDF0"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="7,3"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="surface" Background="{TemplateBinding Background}" CornerRadius="5" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Opacity" Value="0.78"/><Setter TargetName="surface" Property="BorderBrush" Value="#55818A"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="surface" Property="BorderBrush" Value="#8FEDE5"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="surface" Property="Opacity" Value="0.35"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Grid.Resources>
  <Border Name="ShellSurface" CornerRadius="14" BorderThickness="1" BorderBrush="#36545F" Background="#0B1923"/>
  <Grid Margin="1" ClipToBounds="True">
    <Grid Opacity="0"><Grid x:Name="Face">
      <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="17,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Name="CalendarTab" Content="カレンダー" Width="80"/>
        <Button Name="TodoTab" Content="ToDo" Width="62"/>
        <Button Name="MarketTab" Content="株価" Width="48"/>
        <Button Name="WeatherTab" Content="天気" Width="48"/>
        <Button Name="NewsTab" Content="News" Width="50"/>
        <Button Name="TransitTab" Content="運行情報" Width="76"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Name="SettingsButton" Content="⚙" Width="32" AutomationProperties.Name="表示設定"/>

      </StackPanel></Grid>
      <Grid Grid.Row="1" Name="CalendarBody"><Grid.RowDefinitions><RowDefinition Height="101"/><RowDefinition Height="*"/><RowDefinition Height="68"/><RowDefinition Height="43"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" ClipToBounds="True" Background="#102835">
        <Canvas x:Name="SkyMap" IsHitTestVisible="False" ClipToBounds="True"/>
        <Border Height="1" Background="#2A4D58" VerticalAlignment="Top"/>
        <StackPanel Margin="21,13,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
          <TextBlock Name="Year" Foreground="#7BE5DA" FontFamily="Consolas" FontWeight="Bold" FontSize="12"/>
          <StackPanel Orientation="Horizontal">
            <TextBlock Name="Month" FontSize="44" FontFamily="Bahnschrift" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Text="月" FontSize="19" FontWeight="SemiBold" Margin="6,9,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,23,0">
          <Button Name="Previous" Content="‹" Width="30" Height="27" FontFamily="Segoe UI" FontSize="18" Padding="0" Background="#1C3E49" ToolTip="前の月" AutomationProperties.Name="前の月"/>
          <Button Name="Today" Content="今日" Margin="4,0" Background="#1C3E49" Padding="10,2"/>
          <Button Name="Next" Content="›" Width="30" Height="27" FontSize="18" Padding="0" Background="#1C3E49" ToolTip="次の月" AutomationProperties.Name="次の月"/>
        </StackPanel>
      </Grid>
      <Grid Name="Dates" Grid.Row="1" Margin="16,10,16,8"/>
      <Border Grid.Row="2" Background="#152E39" CornerRadius="7" Margin="16,0,16,7" Padding="12,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Name="SelectedDate" Grid.RowSpan="2" FontSize="24" FontFamily="Bahnschrift" VerticalAlignment="Center" HorizontalAlignment="Left"/>
          <TextBlock Name="TodoDayTasks" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" FontSize="12" TextTrimming="CharacterEllipsis" Background="Transparent" Margin="10,0,0,8" Cursor="Hand" Visibility="Collapsed"/>
          <StackPanel Name="TodayWeatherGroup" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Name="TodayWeather" Text="" FontSize="26" FontFamily="Segoe UI Symbol" Foreground="#F4DD8E" VerticalAlignment="Center"/>
            <StackPanel Name="TodayTemperatures" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center"><TextBlock Name="TodayHigh" FontSize="12" Foreground="#F4B09F"/><TextBlock Name="TodayLow" FontSize="12" Foreground="#8EC5FF" Margin="8,0,0,0"/></StackPanel>
          </StackPanel>
          <TextBlock Name="HolidayName" Grid.Column="1" TextTrimming="CharacterEllipsis" Background="Transparent" FontSize="11" Foreground="#FF9699" VerticalAlignment="Center" Margin="10,0,10,0"/>

        </Grid>
      </Border>
      <Grid Grid.Row="3" Margin="17,0">
        <Grid.RowDefinitions><RowDefinition Height="14"/><RowDefinition Height="29"/></Grid.RowDefinitions>
        <Border Background="#25424C" Height="2" VerticalAlignment="Top"/>
        <Border Name="YearGauge" Background="#7BE5DA" Height="2" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid Name="TimerProgressTrack" Height="4" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed" Background="#25424C"><Border Name="TimerProgress" Width="0" HorizontalAlignment="Left" Background="#7BE5DA" CornerRadius="2"/></Grid>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Name="TimerDuration" Content="30 分" Width="70" ToolTip="タイマーの時間を選択"/>
          <Button Name="FocusButton" Content="▶" Width="32" ToolTip="タイマーを開始・停止"/>
        </StackPanel>
        </Grid>
      </Grid>
      </Grid>
      <StackPanel Grid.Row="1" Name="DataBody" Margin="20,12" Visibility="Collapsed">
        <Grid Name="DataHeader" Height="25">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Name="SectionLabel" Foreground="#86E8DE" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center"/><Button Name="MarketRange" Content="3 MONTHS ▾" FontFamily="Consolas" Foreground="#86E8DE" FontSize="13" Padding="5,2" Visibility="Collapsed"/></StackPanel>
          <StackPanel Name="NewsCategories" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"><Button Name="NewsCategory0" Content="総合"/><Button Name="NewsCategory1" Content="経済" Margin="4,0,0,0"/><Button Name="NewsCategory2" Content="IT" Margin="4,0,0,0"/></StackPanel>
          <StackPanel Name="WeatherSwitch" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"><Button Name="RainMode" Content="雨雲" Background="#296675"/><Button Name="DailyMode" Content="3日間の天気" Margin="5,0,0,0"/></StackPanel>
        </Grid>
        <TextBlock Name="DataTitle" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,0"/>
        <TextBlock Name="MarketValue" FontFamily="Bahnschrift" FontSize="24" Foreground="#86E8DE" Margin="0,1,0,3" Visibility="Collapsed"/>
        <Grid Name="DataStampRow" Height="26" Margin="0,3,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Name="DataStamp" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="#D0E5EB" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <Button Name="RefreshData" Grid.Column="1" Content="更新" MinWidth="44"/>
        </Grid>
        <Grid Name="DataChoices" Height="33"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ScrollViewer Name="MarketScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Name="MarketChoices" Orientation="Horizontal"/></ScrollViewer>
          <ScrollViewer Name="WeatherScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Name="WeatherChoices" Orientation="Horizontal"/></ScrollViewer>
          <StackPanel Name="RegionChoices" Orientation="Horizontal"><Button Name="Choice0" Margin="0,0,5,0"/><Button Name="Choice1" Margin="0,0,5,0"/><Button Name="Choice2"/><Button Name="Choice3" Margin="5,0,0,0"/><Button Name="Choice4" Margin="5,0,0,0"/></StackPanel>
          <Button Name="ManageMarkets" Grid.Column="1" Content="＋" ToolTip="表示する銘柄を設定" Visibility="Collapsed" AutomationProperties.Name="銘柄を管理"/>
        <StackPanel Name="MapTools" Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
          <Button Name="PickPlace" Content="＋ 地点" ToolTip="駅名・地名・住所の検索、または地図で基準地点を指定" Background="#193B48" Padding="8,3"/>
          <Button Name="ManageWeatherPlaces" Content="管理" ToolTip="登録地点と表示する範囲を管理" Margin="4,0,0,0" Padding="7,3"/>
          <Button Name="AutoPlace" Content="自動測位" ToolTip="保存地点を解除し、自動測位に戻す" Margin="5,0,0,0" Padding="8,3" Visibility="Collapsed"/>
        </StackPanel>
        </Grid>
        <TextBlock Name="MapHint" FontFamily="Segoe UI" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="#B9D7DE" FontSize="12" Margin="0,5,0,0" Visibility="Collapsed"/>
        <Grid Name="RainLegend" Width="414" HorizontalAlignment="Left" Height="27" Margin="0,8,0,1" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><TextBlock Name="RainLegendTitle" Text="降水強度" Foreground="#D5EAEC" FontSize="9"/><TextBlock Name="RainLegendUnit" Text="(mm/h)" Foreground="#AFCAD2" FontSize="9"/></StackPanel>
          <Canvas Name="RainLegendBar" Grid.Column="1" IsHitTestVisible="False"/>
        </Grid>
        <Canvas Name="Plot" Background="Transparent" Width="414" Height="220" HorizontalAlignment="Left" Margin="0,7,0,0" ClipToBounds="True"/>
        <Canvas Name="TemperaturePlot" Width="414" Height="66" Margin="0,5,0,0" ClipToBounds="True" Visibility="Collapsed"/>
        <StackPanel Name="DailyWeatherBody" Visibility="Collapsed"/>
        <StackPanel Name="InformationBody" Visibility="Collapsed"/>
        <TextBlock Name="PlotCaption" Foreground="#CAEAEB" FontSize="13" Margin="0,6,0,6"/>
        <Grid Name="RadarControls" Width="414" Height="48" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition Width="356"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="24"/></Grid.RowDefinitions>
          <Slider Name="RadarTime" Width="366" Minimum="0" Maximum="6" IsSnapToTickEnabled="False" IsMoveToPointEnabled="True" Margin="-5,0,0,0" HorizontalAlignment="Left"/>
          <TextBlock Name="RadarClock" Grid.Column="1" Foreground="#F4DD8E" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" FontSize="14"/>
          <TextBlock Name="RadarRange" Grid.Row="1" Foreground="#92B5BE" FontSize="11" VerticalAlignment="Center"/>
          <Button Name="RadarPlay" Grid.Column="1" Grid.Row="1" Content="▶" Width="30" HorizontalAlignment="Right" ToolTip="雨雲の時刻を再生"/>
        </Grid>
        <Button Name="DataSource" HorizontalAlignment="Left" Foreground="#A6D3D6" Padding="0,2"/>
      </StackPanel>
      <Grid Grid.Row="1" Name="TodoBody" Margin="20,12,20,12" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
        <Grid Name="TodoHeader">
          <StackPanel>
            <TextBlock Text="TODO" Foreground="#86E8DE" FontFamily="Consolas" FontSize="13" Height="25" Padding="0,4,0,0"/>
            <TextBlock Name="TodoHeading" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,0"/>
            <TextBlock Name="TodoSummary" Foreground="#D0E5EB" FontSize="14" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <Button Name="AddTodo" Content="＋" Width="44" Height="44" FontSize="26" Padding="0,0,0,3" Background="#287181" Foreground="#E5FFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0" ToolTip="タスクを追加" AutomationProperties.Name="タスクを追加"/>
        </Grid>
        <StackPanel Grid.Row="1" Name="TodoList" Margin="0,10,0,0"/>
        <Grid Grid.Row="2" Name="TodoFooter">
          <Button Name="TodoDoneToggle" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#92B5BE" FontSize="12" Padding="6,3" Margin="-6,0,0,0" Visibility="Collapsed"/>
          <StackPanel Name="TodoUndo" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock Name="TodoUndoText" Foreground="#B8E9E4" FontSize="12" MaxWidth="250" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <Button Name="TodoUndoButton" Content="元に戻す" Foreground="#8FE4DD" Margin="6,0,0,0" FontSize="12"/>
          </StackPanel>
          <StackPanel Name="TodoPager" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
            <Button Name="TodoPrevious" Content="‹" Width="32" FontSize="18" Padding="0" AutomationProperties.Name="前のタスクページ"/>
            <TextBlock Name="TodoPage" Width="52" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="#AFCAD2"/>
            <Button Name="TodoNext" Content="›" Width="32" FontSize="18" Padding="0" AutomationProperties.Name="次のタスクページ"/>
          </StackPanel>
        </Grid>
        <Grid Name="TodoDetail" Grid.RowSpan="3" Background="#0B1923" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions>
          <Button Name="TodoBack" Content="‹  一覧" HorizontalAlignment="Left" Foreground="#8FE4DD" Padding="6,3"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="EditTodo" Content="編集" Background="#193B48" Padding="10,3"/>
            <Button Name="DeleteTodo" Content="削除" Margin="6,0,0,0" Padding="10,3"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock Name="TodoDetailTitle" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="62" TextTrimming="CharacterEllipsis"/>
            <TextBlock Name="TodoDetailDue" FontSize="13" Margin="0,5,0,0"/>
          </StackPanel>
          <Border Grid.Row="2" Background="#152E39" CornerRadius="8" Margin="0,10,0,8">
            <ScrollViewer Name="TodoDetailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,12,8,12">
              <ScrollViewer.Resources><Style TargetType="ScrollBar"><Setter Property="Width" Value="7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Border Background="Transparent"><Track Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                  <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                  <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#528793" CornerRadius="3" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                  <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                </Track></Border>
              </ControlTemplate></Setter.Value></Setter></Style></ScrollViewer.Resources>
              <StackPanel Name="TodoDetailContent" Margin="0,0,6,0"/>
            </ScrollViewer>
          </Border>
          <Button Name="CompleteTodo" Grid.Row="3" Content="✓  Done" Background="#287181" Foreground="#E5FFFF" FontSize="14" Padding="20,7" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="完了して一覧から外す"/>
        </Grid>
      </Grid>
      <Grid Name="LoadingArea" Grid.Row="1" Margin="20,153,20,24" Background="#0B1923" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.Name="データを読み込んでいます"/>

      <Border Name="RangePicker" Grid.RowSpan="2" Width="156" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="108,87,0,0" Background="#102835" BorderBrush="#528793" BorderThickness="1" CornerRadius="7" Padding="7" Visibility="Collapsed"><StackPanel Name="RangeChoices"/></Border>
      <Border Name="CreditsPicker" Grid.RowSpan="2" Width="390" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#102835" BorderBrush="#528793" BorderThickness="1" CornerRadius="10" Padding="16" Visibility="Collapsed"><StackPanel><Grid><TextBlock Text="データ出典" FontSize="16" Foreground="#8FE4DD"/><Button Name="CloseCredits" Content="×" Width="28" HorizontalAlignment="Right"/></Grid><StackPanel Name="CreditLinks" Margin="0,12,0,0"/></StackPanel></Border>
      <Border Name="SettingsPicker" Grid.RowSpan="2" Width="422" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,48"
              Background="#102835" BorderBrush="#528793" BorderThickness="1" CornerRadius="10" Padding="13" Visibility="Collapsed">
        <StackPanel>
          <Grid Margin="3,0,3,7">
            <StackPanel Orientation="Horizontal"><TextBlock Text="粒子の設定" FontSize="16" Foreground="#8FE4DD" VerticalAlignment="Center"/><Button Name="SettingsMarkets" Content="銘柄管理 →" Margin="10,0,0,0" Background="#193B48"/><Button Name="StartupToggle" Content="自動起動 OFF" FontSize="11" Padding="6,3" Margin="8,0,0,0" Background="#193B48"/><Button Name="UpdateButton" Content="アプリ更新" FontSize="11" Padding="6,3" Margin="6,0,0,0" Background="#287181" ToolTip="Orbit Calendarを最新版に更新" Visibility="Collapsed"/></StackPanel>
            <Button Name="CloseSettingsPicker" AutomationProperties.Name="設定を閉じる" Content="×" Width="28" Height="28" HorizontalAlignment="Right"/>
          </Grid>
          <TextBlock Text="見た目" Foreground="#92B5BE" FontSize="12" Margin="4,0,0,3"/>
          <UniformGrid Name="PatternChoices" Columns="4"/>
          <StackPanel Orientation="Horizontal" Margin="4,9,4,3"><Button Name="SettingsTransition" Content="画面切り替え"/><Button Name="SettingsLoading" Content="読み込み中" Margin="6,0,0,0"/><Button Name="SettingsTabs" Content="表示するタブ" Margin="6,0,0,0"/></StackPanel>
          <Grid Name="SettingsSection" Height="180"><StackPanel Name="TabSettings" Visibility="Collapsed">
            <TextBlock Text="表示するタブ" Foreground="#92B5BE" FontSize="12" Margin="4,9,0,3"/>
            <UniformGrid Name="TabChoices" Columns="3"/>
            <TextBlock Name="TabSettingsHint" Text="押すと表示／非表示を切り替えます。カレンダーは常に表示されます" Foreground="#92B5BE" FontSize="11" TextWrapping="Wrap" Margin="4,10,4,0"/>
          </StackPanel><StackPanel Name="TransitionSettings">
          <TextBlock Text="組み上がり方" Foreground="#92B5BE" FontSize="12" Margin="4,9,0,3"/>
          <UniformGrid Name="MotionChoices" Columns="3"/>
          <Border Name="PreviewArea" BorderBrush="#2A5965" BorderThickness="1" CornerRadius="6" Padding="12" Margin="4,10,4,3">
            <StackPanel>
              <TextBlock Name="PreviewTitle" Text="W45.2" Foreground="#B5F8ED" FontFamily="Bahnschrift" FontSize="29" HorizontalAlignment="Center"/>
              <TextBlock Text="01   02   03   04   05   06   07" Foreground="#8EC5FF" FontFamily="Consolas" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,0"/>
              <TextBlock Text="08   09   10   11   12   13   14" Foreground="#DBEDF0" FontFamily="Consolas" FontSize="14" HorizontalAlignment="Center"/>
            </StackPanel>
          </Border>
          </StackPanel><StackPanel Name="LoadingSettings" Visibility="Collapsed">
            <TextBlock Text="ローディングのデザイン" Foreground="#92B5BE" FontSize="12" Margin="4,9,0,3"/>
            <UniformGrid Name="LoadingChoices" Columns="3"/>
            <Border Name="LoadingPreviewArea" Height="132" BorderBrush="#2A5965" BorderThickness="1" CornerRadius="6" Margin="4,10,4,3"><Grid Name="LoadingPreview" ClipToBounds="True"/></Border>
          </StackPanel></Grid>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Name="ReplayPreview" Content="▶  もう一度プレビュー" HorizontalAlignment="Left" Foreground="#8FE4DD" Margin="4,3"/><Button Name="AnimationSpeed" Grid.Column="1" Content="速度：標準 ▾" HorizontalAlignment="Center" Width="108" Margin="0,3" ToolTip="画面の開閉・切り替えの演出速度"/><Button Name="OpenCredits" Grid.Column="2" Content="データ出典" HorizontalAlignment="Right" Margin="4,3" Foreground="#92B5BE"/></Grid>
        </StackPanel>
      </Border>
      <Border Name="SpeedPicker" Grid.RowSpan="2" Width="176" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,82" Background="#102835" BorderBrush="#528793" BorderThickness="1" CornerRadius="7" Padding="7" Visibility="Collapsed"><StackPanel Name="SpeedChoices"/></Border>
      <Border Name="TimerPicker" Grid.RowSpan="2" Width="312" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,17,48"
              Background="#102835" BorderBrush="#528793" BorderThickness="1" CornerRadius="10" Padding="12" Visibility="Collapsed">
        <StackPanel>
          <Grid Margin="4,0,4,8">
            <TextBlock Text="タイマーの時間" FontSize="15" Foreground="#8FE4DD" VerticalAlignment="Center"/>
            <Button Name="CloseTimePicker" AutomationProperties.Name="時間選択を閉じる" Content="×" Width="28" Height="28" HorizontalAlignment="Right"/>
          </Grid>
          <UniformGrid Name="TimeChoices" Columns="4"/>
          <TextBlock Name="TimePickerHint" Text="時間を選び、▶ でスタート" Foreground="#92B5BE" FontSize="12" Margin="4,10,0,0"/>
        </StackPanel>
      </Border>
    </Grid>
    </Grid>
    <Grid Name="Effects" IsHitTestVisible="False" ClipToBounds="True"/>
    <Grid IsHitTestVisible="False" RenderTransform="{Binding RenderTransform, ElementName=ShellSurface}" RenderTransformOrigin="{Binding RenderTransformOrigin, ElementName=ShellSurface}"><Ellipse Name="AppUpdateBadge" Width="7" Height="7" Fill="#FFD65B" Stroke="#0B1923" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,18,0" Visibility="Collapsed" IsHitTestVisible="False"/></Grid>
